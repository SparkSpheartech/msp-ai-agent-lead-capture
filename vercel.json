{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "rewrites": [
    { "source": "/blog/(.*)", "destination": "https://blog.sparkspheartechsolutions.com/$1" },
    { "source": "/guides/(.*)", "destination": "https://sparkspheartechsolutions.com/guides/$1" }
  ]
}