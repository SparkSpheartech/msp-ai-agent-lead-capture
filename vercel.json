{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/blog/(.*)",
      "destination": "https://blog.sparkspheartechsolutions.com/$1"
    }
  ],
  "redirects": [
    {
      "source": "/markets",
      "destination": "/guides",
      "permanent": true
    }
  ]
}
